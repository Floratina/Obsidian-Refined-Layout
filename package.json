{
  "name": "refined-layout",
  "version": "0.2.0",
  "description": "Independent layout and typography controls for editing and reading views.",
  "main": "main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint . && stylelint styles.css",
    "check:css": "node scripts/check-css.mjs",
    "test:i18n": "node --test tests/i18n/*.test.mjs",
    "test:settings-search": "node --test tests/settings-search/*.test.mjs",
    "check": "npm run lint && npm run check:css && npm run test:i18n && npm run test:settings-search && npm run build -- --no-sync"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "obsidian": "^1.13.1",
    "stylelint": "^17.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
